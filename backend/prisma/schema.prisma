generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id            String               @id @default(uuid())
  name          String
  email         String               @unique
  passwordHash  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  membership    Membership?
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  assignedTasks Task[]               @relation("TaskAssignee")
  createdTasks  Task[]               @relation("TaskCreator")
  auditActor    AuditLog[]           @relation("AuditActor")
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  invitations   Invitation[]
  projects      Project[]
  tasks         Task[]
  customers     Customer[]
  subscription  Subscription?
  usageCounters UsageCounter[]
  auditLogs     AuditLog[]
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String       @unique
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role             @default(MEMBER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email, status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id              String            @id @default(uuid())
  code            String            @unique
  name            String
  pricePaise      Int               @default(0)
  seatLimit       Int
  projectLimit    Int?
  apiRequestLimit Int
  stripePriceId   String?
  subscriptions   Subscription[]
  entitlements    PlanEntitlement[]
}

model Entitlement {
  id          String            @id @default(uuid())
  code        String            @unique
  description String
  plans       PlanEntitlement[]
}

model PlanEntitlement {
  planId        String
  entitlementId String
  enabled       Boolean     @default(false)
  plan          Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@id([planId, entitlementId])
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  billingCycle         String             @default("MONTHLY")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
}

model Project {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         ProjectStatus     @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]
  customerLinks  ProjectCustomer[]

  @@index([organizationId, status, createdAt])
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  assigneeId     String?
  creatorId      String
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User         @relation("TaskCreator", fields: [creatorId], references: [id])

  @@index([organizationId, assigneeId, status])
  @@index([projectId])
}

model Customer {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  email          String?
  company        String?
  phone          String?
  notes          String?
  archived       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       ProjectCustomer[]

  @@index([organizationId, archived, createdAt])
}

model ProjectCustomer {
  projectId  String
  customerId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([projectId, customerId])
}

model UsageCounter {
  id             String       @id @default(uuid())
  organizationId String
  month          String
  apiRequests    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, month])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
